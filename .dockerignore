.git
.gitignore
.env
.env.*
!.env.example
Dockerfile
.dockerignore
# Keep docs/csv_import/: the back office's CSV Import page links straight to
# it ("Download sample csv files"); only the vendor readmes and licence
# copies are dropped (AGENTS.md, 2026-10-12).
docs/CHANGELOG.txt
docs/readme_*.txt
docs/licences
*.md
cache/smarty/cache/*
cache/smarty/compile/*
# ...but keep the two placeholder files: Configuration Information reports
# "files are missing" without them
!cache/smarty/cache/index.php
!cache/smarty/compile/index.php
log/*
!log/index.php
node_modules
audit
~$*
