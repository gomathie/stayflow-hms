# Local: copy to .env. Production: enter these in Coolify's Environment Variables tab.
# Never commit .env.

# Full public origin. Local: http://localhost:8080 ; production: https://salisberg.com
PUBLIC_URL=http://localhost:8080
# Local only (docker-compose.override.yml)
HTTP_PORT=8080

MYSQL_DATABASE=salisberg
MYSQL_USER=salisberg
MYSQL_PASSWORD=change-me
# PHP version the image is built with. Leave out for the default in the Dockerfile.
# PHP_VERSION=8.4

# Database version. Leave out to stay on 8.0. Changing to 8.4 cannot be undone
# except by restoring a backup: read AGENTS.md before setting it.
# MYSQL_VERSION=8.4
MYSQL_ROOT_PASSWORD=change-me-too

# Backups: a nightly dump is kept in the db_backups volume. Set a long passphrase
# and keep a copy of it off the server: without it the backups cannot be restored.
BACKUP_PASSPHRASE=change-me-long-random
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=2

# Back office lives at PUBLIC_URL/ADMIN_DIR (must not be "admin")
ADMIN_DIR=admin-salisberg

# 1 = on every start, set the shop domain and HTTPS flags from PUBLIC_URL
SYNC_DOMAIN=1

# First-boot install (skipped once settings exist in the app_data volume)
AUTO_INSTALL=1
SHOP_NAME=Salisberg Hotels
ADMIN_EMAIL=admin@salisberg.com
ADMIN_PASSWORD=change-me-admin
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=Salisberg
SHOP_COUNTRY=us
TIMEZONE=UTC
